# 07 - Web Interface, Linked Exploration and Reproducible Outputs
# Rendered with: d2 --layout dagre
...@_theme

direction: down
grid-columns: 2

title: "Web Interface, Linked Exploration and Reproducible Outputs" {
  shape: text
  near: top-center
  style: { font-size: 27; font-color: "#0F172A"; bold: true }
}
control: "Run and dataset control" {
  class: band_user
  grid-columns: 1
  runs: "My Runs\ncreate - select - resume" { class: user }
  workflow: "Run Workflow\nstatus stepper + explicit cluster command" { class: user }
  gate: "Availability gate\navailable - pending - not applicable\nunavailable - missing / stale / failed" { class: pending }
  runs -> workflow -> gate: { class: flow }
}

dataset: "Canonical scientific dataset" {
  class: band_data
  grid-columns: 1
  identity: "Stable identities\nspecies - transcript - protein - exon" { class: data }
  observations: "Scientific observations\ndomains - boundaries - candidates - alignments" { class: data }
  audit: "Coordinate evidence audit\nmodel-linked records + QC state + source-row provenance" { class: data }
  contract: "Versioned adapter\nanalysis family + schemas + provenance" { class: data }
}

interaction: "Linked Gene Explorer" {
  class: band_user
  grid-columns: 2
  summary: "Summary + quality\nIsoforms + Exon Map" { class: user }
  alignment: "Isoform alignment + MSA\nSynteny" { class: user }
  domains: "Domain Architecture\nBoundary analysis" { class: user }
  evidence: "Candidate / cassette evidence\nwhen applicable" { class: user }
  selection: "Shared selection state\nspecies + scope | transcript + protein\nexon + domain + boundary | candidate / feature\ncomparable group | coordinates | MSA column | figure scope" { class: data }
  downloads: "Data & Downloads" { class: output }
  selection -> summary: { class: ref }
  selection -> alignment: { class: ref }
  selection -> domains: { class: ref }
  selection -> evidence: { class: ref }
}

outputs: "Reproducible output contracts" {
  class: band_output
  grid-columns: 1
  gallery: "Figure Gallery\ninteractive preview + export scope" { class: output }
  files: "Figures: SVG / PDF / PNG\nData: TSV / JSON / FASTA\nincluding coordinate register + provenance JSON" { class: output }
  manifest: "Validated package manifest\nselection - included / omitted items\nsource path - size - SHA-256" { class: filedata }
  gallery -> files: "render / package" { class: flow }
  manifest -> files: "documents" { class: ref }
}

control -> dataset: { class: flow }
dataset -> interaction: { class: flow }
interaction -> outputs: { class: flow }

note: "Figure-parity contract: interactive views and SVG / PDF / PNG exports share semantic identities, labels, ordering, coordinate values and style roles.\nCross-species and candidate / cassette panels are shown only when their declared availability and analysis family support them." {
  near: bottom-center
  class: note
}
