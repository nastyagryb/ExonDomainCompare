# 04 - Scientific Data Flow  (ExonDomainCompare)
# Rendered with: d2 --layout dagre
...@_theme

direction: down

title: |md
  # Scientific Data Flow
| { near: top-center; style: { font-size: 26; font-color: "#0F172A"; bold: true } }

subtitle: |md
  How biological data are transformed - data objects and their backing files
| { near: top-center; style: { font-size: 14; font-color: "#475569" } }

cfg: "Gene + species configuration\ngene_config.yaml - species_list.txt" { class: file }
genes: "Gene records\n(located in cached GFF)" { class: file }
tx: "Transcript models\ngene_model_index.tsv" { class: filedata }
cds: "CDS + exon records\n02_models exons / CDS" { class: filedata }
prot: "Protein sequences\nproteins_all_isoforms.faa - proteins_primary.faa" { class: filedata }
iso: "Primary + alternative isoforms\nprotein_isoform_index.tsv - primary_selection_evidence.tsv" { class: filedata }
emap: "Exon-protein coordinate maps\nexon_protein_map.tsv" { class: filedata }
cand: "Candidate regions  (exploratory)\nevent_candidate_regions.tsv - event_region_evidence.tsv" { class: file }
aln: "Alignments\nisoform_msa__<species>.aln.faa - primaries_msa.aln.faa" { class: filedata }

# ---- annotation split: raw vs normalized ----
ipsraw: "InterProScan signatures  (raw)\ninput.fasta.{tsv,json,gff3} -> interpro_annotations.tsv" { class: file }
domlayers: "Normalized domain layers\ndomain_features.tsv: representative domain / family / feature" { class: filedata }
tmtopo: "pyTMHMM topology  (separate layer)\ntm_features.tsv" { class: filedata }
bnd: "Exon-domain boundary rows\nexon_domain_boundary_distances.tsv / _summary.tsv" { class: filedata }

canon: "Canonical dataset\nwebsite_indices/*.json + canonical dataset model" { class: store }
out: "Interactive views + figures + downloadable tables" { class: output }

# ================= primary transformation spine =================
cfg -> genes -> tx -> cds -> prot -> iso -> emap: { class: flow }
emap -> cand: "isoform differences" { class: optional }
emap -> aln: { class: flow }
iso -> aln: { class: flow }

# cluster annotation (primary proteins only)
prot -> ipsraw: "primary FASTA -> cluster" { class: flow }
ipsraw -> domlayers: "normalize + layer" { class: flow }
prot -> tmtopo: "primary FASTA -> cluster" { class: flow }

# boundary integration
emap -> bnd: "exon boundaries" { class: flow }
domlayers -> bnd: "representative domain edges only" { class: flow }

# converge to canonical dataset
aln -> canon: { class: flow }
cand -> canon: { class: optional }
domlayers -> canon: { class: flow }
tmtopo -> canon: { class: flow }
bnd -> canon: { class: flow }
synteny_obj -> canon: { class: flow }
canon -> out: { class: flow }

synteny_obj: "Local synteny neighbours\nsynteny_neighbors.tsv" { class: filedata }
emap -> synteny_obj: { class: ref }

# ================= scope / distinction annotations =================
scope1: |md
  **Cluster scope:** only **primary proteins** are submitted for
  InterProScan / pyTMHMM. Alternative isoforms are **not** annotated.
| { near: center-right; class: note }

scope2: |md
  **Layer discipline:** raw signatures are preserved for provenance;
  only the **representative domain layer** feeds boundary edges.
  Families, sites, motifs and disorder are **not** domain edges.
| { near: center-right; class: note }

scope3: |md
  **Granularity:** transcript/protein/exon data are **per species**.
  Isoform alignment is **within-species**; primary MSA is **cross-species**.
| { near: bottom-left; class: note }

scope4: |md
  **Evidence status:** candidate regions are **generic exploratory**
  (never validated). FGFR2 replaces them with **validated IIIb/IIIc** evidence.
| { near: bottom-left; class: pending }

legend: "Legend" {
  near: bottom-right
  grid-columns: 2
  l_file: "Data file" { class: file }
  l_fdata: "Tabular dataset" { class: filedata }
  l_store: "Canonical store" { class: store }
  l_out: "Outputs" { class: output }
  l_note: "Scope note" { class: note }
  l_opt: "Optional / exploratory" { class: pending }
}
