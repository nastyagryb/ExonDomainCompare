# 08 - Post-InterPro Annotation + Boundary Pipeline  (ExonDomainCompare)
# Rendered with: d2 --layout dagre
...@_theme

direction: down

title: |md
  # Post-InterPro Annotation + Boundary Pipeline
| { near: top-center; style: { font-size: 25; font-color: "#0F172A"; bold: true } }

subtitle: |md
  The scientifically critical post-cluster phase - layer discipline and boundary classification
| { near: top-center; style: { font-size: 14; font-color: "#475569" } }

fasta: "Primary-protein FASTA\nfinal_pre_interpro_proteins_primary.faa" { class: filedata }
ipr: "InterProScan raw output\ninput.fasta.tsv / .gff3 / .json" { class: file }
tm: "pyTMHMM results\n*.summary -> pytmhmm_summary_all.tsv" { class: file }

norm1: "Protein-ID normalization\nstrip version, reconcile NP_/XP_ accessions" { class: annot }
norm2: "Species / protein ownership mapping\nassign each hit to its species + protein" { class: annot }
records: "Normalized annotation records\nprotein - signature - interpro_type - coords - is_integrated" { class: filedata }

annotsep: "Annotation-layer separation" {
  class: band_annot
  reps: "Representative domains\n(DOMAIN / REPEAT, collapsed)" { class: annot }
  fam: "Families\n(FAMILY / superfamily)" { class: annot }
  feat: "Features / sites / motifs / disorder" { class: annot }
  raw: "Raw signatures\n(all member-DB hits, provenance)" { class: annot }
  topo: "Topology\n(pyTMHMM helices)" { class: annot }
}

exoncoord: "Exon-boundary coordinates\n(internal coding-exon junctions)" { class: filedata }
nearest: "Nearest representative-domain-edge calculation" { class: annot }
classify: "Classification\nexact / near / inside / outside / unknown  (near <= 5 aa)" { class: annot }

# consumers
arch: "Domain Architecture view" { class: output }
bsum: "Boundary summary (Gene Explorer)" { class: output }
gbnd: "Global Exon-Domain Boundaries page" { class: output }
figs: "Figures + downloadable tables" { class: output }

# ================= spine =================
fasta -> ipr: "cluster" { class: flow }
fasta -> tm: "cluster" { class: flow }
ipr -> norm1 -> norm2 -> records: { class: flow }
records -> annotsep: "layer_for(interpro_type)" { class: flow }
tm -> annotsep.topo: { class: flow }

# only representative domains feed boundary edges
exoncoord -> nearest: { class: flow }
annotsep.reps -> nearest: "domain edges only" { class: flow }
nearest -> classify: { class: flow }

# consumers
annotsep.reps -> arch: { class: flow }
annotsep.fam -> arch: "separate lane" { class: flow }
annotsep.feat -> arch: "optional overlay" { class: optional }
annotsep.topo -> arch: "separate topology" { class: flow }
annotsep.raw -> arch: "expandable table" { class: optional }
classify -> bsum: { class: flow }
classify -> gbnd: "same rows + scope" { class: flow }
classify -> figs: { class: flow }
arch -> figs: { class: flow }

# ================= explicit rules =================
rule1: |md
  **Families are not structural domains.** FAMILY / homologous-superfamily
  entries are displayed separately and never counted as domain edges.
| { near: center-right; class: note }

rule2: |md
  **Sites, motifs and disorder are not domain edges** by default; they are
  optional features. **pyTMHMM is a separate topology layer**, never a domain.
| { near: center-right; class: note }

rule3: |md
  **Raw hits are preserved** for provenance. The **representative domain layer**
  drives the default scientific analysis and all boundary edges.
| { near: bottom-left; class: note }

legend: "Legend" {
  near: bottom-right
  grid-columns: 2
  l_file: "Raw file" { class: file }
  l_fdata: "Normalized dataset" { class: filedata }
  l_annot: "Annotation / boundary step" { class: annot }
  l_out: "Output view" { class: output }
  l_opt: "Optional overlay" { class: pending }
}
