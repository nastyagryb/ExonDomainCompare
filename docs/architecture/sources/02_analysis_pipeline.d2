# 02 - End-to-End Analysis Pipeline  (ExonDomainCompare)
# Rendered with: d2 --layout dagre
...@_theme

direction: down

title: |md
  # End-to-End Analysis Pipeline
| { near: top-center; style: { font-size: 26; font-color: "#0F172A"; bold: true } }

subtitle: |md
  Ordered stages of one run - gene + species input to interactive scientific results
| { near: top-center; style: { font-size: 14; font-color: "#475569" } }

# ============================ LOCAL - acquisition & models ============================
A: "A - Input, models & coordinates  (local, pre-cluster)" {
  class: band_local
  a1: "1 - Gene + species input\ngene symbol, species list (>= 1)" { class: local }
  a2: "2 - Gene / transcript resolution\nlocate gene + mRNA in GFF" { class: local }
  a3: "3 - Transcript + protein retrieval\ncached NCBI genomic.gff + protein.faa" { class: local }
  a4: "4 - Protein-coding model filtering\nrequire protein_id + CDS" { class: local }
  a5: "5 - Primary transcript/protein selection\nMANE / canonical / longest" { class: local }
  a6: "6 - Exon / CDS extraction" { class: local }
  a7: "7 - Exon-to-protein coordinate mapping" { class: local }
  a1 -> a2 -> a3 -> a4 -> a5 -> a6 -> a7: { class: flow }
}

# ============================ LOCAL - comparative pre-cluster =========================
B: "B - Comparative pre-cluster analysis  (local)" {
  class: band_local
  b8: "8 - Within-species isoform comparison" { class: local }
  b9: "9 - Exploratory candidate-region detection\noptional - exploratory, never validated" { class: generic }
  b10: "10 - Within-species isoform alignment\nMAFFT" { class: local }
  b11: "11 - Cross-species primary MSA\nmulti-species datasets only" { class: local }
  b12: "12 - Local synteny neighbourhood" { class: local }
  b13: "13 - Pre-cluster freeze + package\nprimary FASTA + generic website indices" { class: filedata }
  b8 -> b9: { class: optional }
  b8 -> b10 -> b12 -> b13: { class: flow }
  b10 -> b11: "if >= 2 species" { class: optional }
  b11 -> b12: { class: flow }
}

# ============================ CLUSTER round trip =====================================
C: "C - LRZ cluster round trip  (Slurm)" {
  class: band_cluster
  c14: "14 - Submit\nscp FASTA + sbatch (primary proteins only)" { class: cluster }
  c15: "15 - InterProScan\n-f TSV,GFF3,JSON" { class: cluster }
  c16: "16 - pyTMHMM\ntransmembrane topology" { class: cluster }
  c17: "17 - Poll status + fetch results\nsqueue / sacct, scp back" { class: cluster }
  c14 -> c15: { class: flow }
  c14 -> c16: { class: flow }
  c15 -> c17: { class: flow }
  c16 -> c17: { class: flow }
}

# ============================ POST-cluster ===========================================
D: "D - Post-InterPro processing  (local, post-cluster)" {
  class: band_annot
  d18: "18 - Annotation normalization\nID normalization + species/protein ownership" { class: annot }
  d19: "19 - Representative domain-layer construction\ncollapse redundant hits; separate family/feature/raw" { class: annot }
  d20: "20 - Exon-domain boundary calculation\nexact / near / inside / outside / unknown (<= 5 aa)" { class: annot }
  d21: "21 - Canonical dataset + index (re)generation" { class: filedata }
  d18 -> d19 -> d20 -> d21: { class: flow }
}

# ============================ PRESENTATION ===========================================
E: "E - Presentation  (served on demand)" {
  class: band_output
  e22: "22 - Frontend presentation\nGene Explorer + dataset-scoped views" { class: output }
  e23: "23 - Figure + report generation\nSVG / PDF / PNG + tables" { class: output }
  e22 -> e23: { class: flow }
}

# ============================ phase transitions ======================================
A.a7 -> B.b8: { class: flow }
B.b13 -> C.c14: "cluster required" { class: flow }
C.c17 -> D.d18: { class: flow }
D.d21 -> E.e22: { class: flow }

# ============================ FGFR2 specialization points ============================
fgfr2: "FGFR2 specialization points" {
  near: center-right
  class: band_fgfr2
  f1: "Selection & export are annotation-aware\n(IIIb/IIIc candidate handling)" { class: fgfr2 }
  f2: "Cassette detection + IIIb/IIIc classification\nreplaces generic candidate step" { class: fgfr2 }
  f3: "Cassette-aware boundary consistency\n+ validated evidence and story" { class: fgfr2 }
}
fgfr2.f1 -> A.a5: { class: spec }
fgfr2.f2 -> B.b9: { class: spec }
fgfr2.f3 -> D.d20: { class: spec }

legend: "Legend" {
  near: bottom-right
  grid-columns: 2
  l_local: "Local stage" { class: local }
  l_cluster: "Cluster stage" { class: cluster }
  l_annot: "Post-cluster" { class: annot }
  l_out: "Presentation" { class: output }
  l_opt: "Optional / dataset-dependent" { class: pending }
  l_fgfr2: "FGFR2 specialization" { class: fgfr2 }
}
