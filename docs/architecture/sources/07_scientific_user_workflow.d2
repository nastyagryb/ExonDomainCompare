# 07 - Researcher Interaction Workflow  (ExonDomainCompare)
# Rendered with: d2 --layout dagre
...@_theme

direction: down

title: |md
  # Researcher Interaction Workflow
| { near: top-center; style: { font-size: 26; font-color: "#0F172A"; bold: true } }

subtitle: |md
  A realistic analytical journey and how selections synchronize the scientific views
| { near: top-center; style: { font-size: 14; font-color: "#475569" } }

journey: "Analytical journey" {
  class: band_user
  j1: "1 - Select or create a run" { class: user }
  j2: "2 - Choose gene + species" { class: user }
  j3: "3 - Inspect dataset quality + primary models" { class: user }
  j4: "4 - Inspect isoform collection" { class: user }
  j5: "5 - Examine exon structure (Exon Map)" { class: user }
  j6: "6 - Select an exploratory or validated event" { class: user }
  j7: "7 - Within-species Isoform Alignment" { class: user }
  j8: "8 - Cross-species MSA (where available)" { class: user }
  j9: "9 - Inspect Domain Architecture" { class: user }
  j10: "10 - Evaluate exon-domain boundaries" { class: user }
  j11: "11 - Inspect synteny" { class: user }
  j12: "12 - Review evidence" { class: user }
  j13: "13 - Export files + figures" { class: output }
  j1 -> j2 -> j3 -> j4 -> j5 -> j6 -> j7 -> j8 -> j9 -> j10 -> j11 -> j12 -> j13: { class: flow }
}

# ---------------- shared selection state ----------------
sel: "Shared scientific selection  (per selected species)" {
  class: band_data
  species: "selected species" { class: data }
  protein: "selected protein" { class: data }
  event: "selected candidate / event" { class: data }
  species -> protein: "sets" { class: ref }
  event -> protein: "sets protein + region" { class: ref }
}

# selection synchronizes the coordinated views
sel.event -> journey.j5: "highlights exon" { class: ref }
sel.event -> journey.j7: "aligns region" { class: ref }
sel.protein -> journey.j9: "selects track" { class: ref }
sel.protein -> journey.j10: "boundary scope" { class: ref }
sel.species -> journey.j8: "one primary / species" { class: ref }

# ---------------- multi-species semantics ----------------
ms: |md
  **Multi-species semantics**
  - Cross-species **MSA** compares **one primary protein per species**.
  - **Isoform Alignment** compares isoforms **only within** the selected species.
  - Species selection drives all species-specific views.
| { near: center-right; class: note }

# ---------------- pending / conditional ----------------
pend: |md
  Domain Architecture and Boundary views require completed
  InterProScan / pyTMHMM; before that they show a calm **pending** state.
  Cross-species MSA appears only for **multi-species** datasets.
| { near: bottom-left; class: pending }

legend: "Legend" {
  near: bottom-right
  grid-columns: 2
  l_step: "Journey step" { class: user }
  l_sel: "Selection state" { class: data }
  l_out: "Export" { class: output }
  l_note: "Semantics" { class: note }
  l_pend: "Conditional / pending" { class: pending }
}
