# 06 - Generic Framework vs FGFR2 Specialization  (ExonDomainCompare)
# Rendered with: d2 --layout dagre
...@_theme

direction: down

title: |md
  # One Generic Framework, FGFR2 as a Specialization
| { near: top-center; style: { font-size: 25; font-color: "#0F172A"; bold: true } }

subtitle: |md
  Single-species and multi-species use the same pipeline - species is a dataset property, not a code path
| { near: top-center; style: { font-size: 14; font-color: "#475569" } }

# ============================= SHARED FOUNDATION =============================
base: "Shared generic foundation  (used by every gene + every species count)" {
  class: band_local
  grid-columns: 3
  s1: "Input + run management" { class: local }
  s2: "Transcript / protein acquisition" { class: local }
  s3: "Primary-model selection" { class: local }
  s4: "Exon / CDS parsing" { class: local }
  s5: "Exon-protein mapping" { class: local }
  s6: "Alignments (MAFFT)" { class: local }
  s7: "Synteny" { class: local }
  s8: "InterProScan / pyTMHMM" { class: annot }
  s9: "Domain normalization + layers" { class: annot }
  s10: "Boundary analysis" { class: annot }
  s11: "Canonical dataset" { class: data }
  s12: "Shared frontend components" { class: user }
}

# ============================== TWO MODES ==============================
generic: "Generic exploratory mode  (arbitrary genes)" {
  class: band_generic
  grid-columns: 2
  g1: "Isoform Alignment (within-species)" { class: generic }
  g2: "Cross-species MSA (where applicable)" { class: generic }
  g3: "Exploratory Candidate Evidence" { class: generic }
  g4: "Generic exon-boundary interpretation" { class: generic }
  g5: "Generic domain architecture" { class: generic }
  g6: "Generic synteny + evidence" { class: generic }
  g0: |md
    No IIIb / IIIc or cassette terminology.
    Examples: FGFR1, TPM1, TP53 (core-only pilots).
  | { class: note }
}

fgfr2: "FGFR2 validated use case  (specialization)" {
  class: band_fgfr2
  grid-columns: 2
  f1: "IIIb / IIIc cassette interpretation" { class: fgfr2 }
  f2: "Validated cassette evidence" { class: fgfr2 }
  f3: "FGFR2-specific biological story" { class: fgfr2 }
  f4: "Specialized visual overlays" { class: fgfr2 }
  f5: "Curated biological interpretation" { class: fgfr2 }
  f0: |md
    Adds interpretation on top of the shared base;
    does **not** fork the pipeline.
  | { class: note }
}

# ============================== construction ==============================
base -> generic: "same modules" { class: flow }
base -> fgfr2: "same modules + accent layers" { class: spec }

# ============================== species note ==============================
species: |md
  **Single-species** is simply a dataset with one species; **multi-species**
  reuses the identical pipeline. Species are stored as a collection either way.
  Within-species isoform alignment stays species-specific; cross-species MSA
  compares one primary protein per species.
| { near: bottom-center; class: band_neutral }

legend: "Legend" {
  near: bottom-right
  grid-columns: 2
  l_local: "Shared foundation" { class: local }
  l_annot: "Annotation / boundary" { class: annot }
  l_generic: "Generic exploratory" { class: generic }
  l_fgfr2: "FGFR2 specialization" { class: fgfr2 }
}
