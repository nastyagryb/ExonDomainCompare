# 03 - Software Component Diagram  (ExonDomainCompare)
# Rendered with: d2 --layout dagre
...@_theme

direction: down

title: |md
  # Software Component Diagram
| { near: top-center; style: { font-size: 26; font-color: "#0F172A"; bold: true } }

subtitle: |md
  Reusable components grouped by architectural layer - dependencies and reuse (not a source-file listing)
| { near: top-center; style: { font-size: 14; font-color: "#475569" } }

# ================================= FRONTEND =================================
fe: "Frontend  (React / Vite SPA)" {
  class: band_user
  shell: "Application shell + navigation\npage-state routing" { class: user }
  switch: "Dataset / run selector" { class: user }
  explorer: "Gene Explorer\nSummary - Isoforms - Evidence - Files - Exon map -\nDomain architecture - Boundary - Alignment/MSA - Synteny" { class: user }
  viewers: "Scientific viewers\nDomain Architecture - Coordinate/Exon track -\nMSA / Isoform Alignment - Synteny" { class: user }
  pages: "Overview - Boundaries - Figure Gallery - My Runs" { class: user }
  state: "Shared scientific selection / state\nspecies - protein - transcript - exon - candidate" { class: user }
  apilib: "API client (api.js)" { class: user }

  shell -> switch: { class: flow }
  shell -> explorer: { class: flow }
  shell -> pages: { class: flow }
  explorer -> viewers: { class: flow }
  state -> explorer: { class: ref }
  state -> viewers: { class: ref }
}

# ================================= BACKEND =================================
be: "Backend  (FastAPI)" {
  class: band_user
  app: "FastAPI application\nroutes + dataset scoping (?dataset=)" { class: user }
  disc: "Run discovery\nexample + local runs" { class: user }
  resolve: "Dataset resolver\nexample vs run:<id>" { class: user }
  canon: "Canonical dataset model\nread-only adapter, versioned" { class: data }
  serial: "Index serialization\nsummary / domain / boundary / msa / synteny ..." { class: user }
  files: "File serving\nrun files + downloads (path-guarded)" { class: user }
  app -> disc: { class: flow }
  app -> resolve: { class: flow }
  resolve -> canon: { class: flow }
  app -> serial: { class: flow }
  app -> files: { class: flow }
}

# =========================== SHARED ANALYSIS LAYER ===========================
shared: "Shared analysis layer  (generic, gene-agnostic)" {
  class: band_local
  router: "Analysis router" { class: local }
  retrieve: "Gene/transcript retrieval + GFF/CDS parsing" { class: local }
  primary: "Primary-model selection" { class: local }
  exonmap: "Exon-protein mapping" { class: local }
  candidate: "Exploratory candidate analysis" { class: generic }
  align: "Alignment generation (MAFFT)" { class: local }
  synteny: "Synteny generation" { class: local }
  iprnorm: "InterPro normalization\n(domain/family/feature/raw layers)" { class: annot }
  tmnorm: "pyTMHMM normalization (topology)" { class: annot }
  boundary: "Boundary analysis" { class: annot }
  indices: "Generic + FGFR2-compatible index builders" { class: local }
  figs: "Figure generation (plotting API)" { class: local }
  cluster: "Cluster round trip\nsubmit / check / fetch (SSH + Slurm)" { class: cluster }
}

# ============================== SPECIALIZED LAYER ==============================
spec: "Specialized layer  (FGFR2 validated use case)" {
  class: band_fgfr2
  collect: "Dual-source collection + annotation-aware selection" { class: fgfr2 }
  classify: "IIIb/IIIc cassette classification + validation/rescue" { class: fgfr2 }
  export: "FGFR2 protein export + clean InterPro FASTA" { class: fgfr2 }
  fidx: "FGFR2 website indices" { class: fgfr2 }
  fstory: "FGFR2 evidence, story, cassette + boundary-consistency overlays" { class: fgfr2 }
}

# ============================ PERSISTENCE / ARTIFACTS ============================
store: "Persistence / artifacts" {
  class: band_data
  rundir: "runs/<RUN_ID>/\nconfig - raw inputs - staged results - freeze - cluster outputs" { class: store }
  genidx: "website_indices/ (+ generic/)\ncanonical frontend indices" { class: filedata }
  example: "FGFR2 example dataset\n(frozen closure indices)" { class: store }
  reports: "Reports + figures" { class: filedata }
}

# ================================ dependencies ================================
fe.apilib -> be.app: "HTTP (JSON + files)" { class: flow }
fe.shell -> fe.apilib: { class: ref }

be.canon -> store.genidx: "reads indices" { class: flow }
be.canon -> store.example: "reads (read-only)" { class: flow }
be.serial -> store.genidx: "reads" { class: flow }
be.files -> store.rundir: "reads" { class: flow }
be.disc -> store.rundir: "scans" { class: ref }

shared.router -> shared.retrieve: { class: ref }
shared.retrieve -> store.rundir: "writes models" { class: flow }
shared.boundary -> store.genidx: "writes" { class: flow }
shared.indices -> store.genidx: "writes" { class: flow }
shared.figs -> store.reports: "writes" { class: flow }
shared.cluster -> store.rundir: "writes cluster outputs" { class: flow }

spec.collect -> shared.retrieve: "builds on" { class: spec }
spec.classify -> shared.candidate: "specializes" { class: spec }
spec.export -> shared.cluster: "feeds" { class: spec }
spec.fidx -> store.genidx: "writes FGFR2 indices" { class: flow }
spec.fstory -> store.reports: "writes" { class: flow }

legend: "Legend" {
  near: bottom-right
  grid-columns: 2
  l_fe: "Frontend / backend" { class: user }
  l_local: "Shared analysis" { class: local }
  l_annot: "Annotation / boundary" { class: annot }
  l_cluster: "Cluster" { class: cluster }
  l_data: "Persistence" { class: data }
  l_fgfr2: "FGFR2 specialization" { class: fgfr2 }
}
