# =====================================================================
# ExonDomainCompare - Architecture Atlas shared visual identity
# ---------------------------------------------------------------------
# Imported by every diagram via:  ...@_theme
# Semantic colour groups have STABLE meaning across all figures.
# Do not assign a unique colour to every small component.
# =====================================================================

vars: {
  d2-config: {
    sketch: false
    pad: 24
    center: true
  }
}

classes: {
  # ---- Semantic component groups (rounded rectangles) --------------
  user: {                       # researcher-facing / frontend
    style: { fill: "#E8EDFB"; stroke: "#3B5BDB"; stroke-width: 2; font-color: "#1A2B5E"; border-radius: 10 }
  }
  local: {                      # local computational pipeline
    style: { fill: "#E3F7F9"; stroke: "#0B7285"; stroke-width: 2; font-color: "#06373F"; border-radius: 10 }
  }
  cluster: {                    # LRZ Slurm cluster computation
    style: { fill: "#FFF1E6"; stroke: "#E8590C"; stroke-width: 2; font-color: "#7A2E06"; border-radius: 10 }
  }
  data: {                       # scientific data object
    style: { fill: "#F1ECFC"; stroke: "#6741D9"; stroke-width: 2; font-color: "#331C7A"; border-radius: 10 }
  }
  annot: {                      # annotation & boundary analysis
    style: { fill: "#E6FBF4"; stroke: "#0C8599"; stroke-width: 2; font-color: "#08484F"; border-radius: 10 }
  }
  generic: {                    # generic exploratory mode
    style: { fill: "#E9FAEE"; stroke: "#2F9E44"; stroke-width: 2; font-color: "#14532A"; border-radius: 10 }
  }
  output: {                     # outputs, figures, downloads
    style: { fill: "#FEF7DE"; stroke: "#F08C00"; stroke-width: 2; font-color: "#7A4A00"; border-radius: 10 }
  }
  fgfr2: {                      # FGFR2 validated specialization (accent)
    style: { fill: "#FDECF3"; stroke: "#C2255C"; stroke-width: 3; font-color: "#6E0F35"; border-radius: 10 }
  }

  # ---- Shape-specific variants -------------------------------------
  person: {                     # actor
    shape: person
    style: { fill: "#E8EDFB"; stroke: "#3B5BDB"; stroke-width: 2; font-color: "#1A2B5E" }
  }
  external: {                   # external system (muted container)
    shape: cloud
    style: { fill: "#EEF1F4"; stroke: "#64748B"; stroke-width: 2; font-color: "#33404F" }
  }
  store: {                      # genuine persistent store
    shape: cylinder
    style: { fill: "#F1ECFC"; stroke: "#6741D9"; stroke-width: 2; font-color: "#331C7A" }
  }
  file: {                       # file / dataset (document)
    shape: page
    style: { fill: "#F1ECFC"; stroke: "#6741D9"; stroke-width: 2; font-color: "#331C7A" }
  }
  filedata: {                   # data file emphasised (stored data)
    shape: stored_data
    style: { fill: "#F1ECFC"; stroke: "#6741D9"; stroke-width: 2; font-color: "#331C7A" }
  }

  # ---- Group containers (light, labelled) --------------------------
  band_user:    { style: { fill: "#F5F7FE"; stroke: "#3B5BDB"; stroke-width: 2; font-color: "#1A2B5E"; border-radius: 14 } }
  band_local:   { style: { fill: "#F2FBFC"; stroke: "#0B7285"; stroke-width: 2; font-color: "#06373F"; border-radius: 14 } }
  band_cluster: { style: { fill: "#FFF8F2"; stroke: "#E8590C"; stroke-width: 2; font-color: "#7A2E06"; border-radius: 14 } }
  band_annot:   { style: { fill: "#F1FCF8"; stroke: "#0C8599"; stroke-width: 2; font-color: "#08484F"; border-radius: 14 } }
  band_generic: { style: { fill: "#F4FCF6"; stroke: "#2F9E44"; stroke-width: 2; font-color: "#14532A"; border-radius: 14 } }
  band_data:    { style: { fill: "#F8F5FE"; stroke: "#6741D9"; stroke-width: 2; font-color: "#331C7A"; border-radius: 14 } }
  band_output:  { style: { fill: "#FFFCEF"; stroke: "#F08C00"; stroke-width: 2; font-color: "#7A4A00"; border-radius: 14 } }
  band_fgfr2:   { style: { fill: "#FEF4F8"; stroke: "#C2255C"; stroke-width: 2; font-color: "#6E0F35"; border-radius: 14; double-border: true } }
  band_neutral: { style: { fill: "#FBFCFE"; stroke: "#94A3B8"; stroke-width: 2; font-color: "#33404F"; border-radius: 14 } }

  # ---- Note / caption chips ----------------------------------------
  note:    { style: { fill: "#FFFDF5"; stroke: "#CBAE60"; stroke-width: 1; font-color: "#6B5518"; border-radius: 6; font-size: 13 } }
  pending: { style: { fill: "#F8FAFC"; stroke: "#94A3B8"; stroke-width: 1; stroke-dash: 4; font-color: "#475569"; border-radius: 6; font-size: 13 } }

  # ---- Edge relationship vocabulary --------------------------------
  flow:     { style: { stroke: "#334155"; stroke-width: 2 } }            # primary data flow
  optional: { style: { stroke: "#8093AB"; stroke-width: 2; stroke-dash: 5 } }  # optional / conditional
  ref:      { style: { stroke: "#A9B4C4"; stroke-width: 1; stroke-dash: 2 } } # configuration / reference
  spec:     { style: { stroke: "#C2255C"; stroke-width: 2 } }            # specialization link
}
